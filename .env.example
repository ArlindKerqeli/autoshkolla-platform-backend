# ============================================================
# AutoShkolla Platform — Backend Environment
# ============================================================

# --- Flask ---
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-me-in-production
PORT=5002

# --- Database ---
# Local Postgres for development
DATABASE_URL=postgresql://autoshkolla:dev_password@localhost:5432/autoshkolla_pro
# Production (Supabase / DigitalOcean Managed Postgres) — set in deploy env, not here
# DATABASE_URL=postgresql://USER:PASS@HOST:PORT/DB

# --- JWT ---
JWT_SECRET=change-me-in-production
JWT_ACCESS_EXPIRATION=60m
JWT_REFRESH_EXPIRATION=7d

# --- CORS ---
# Comma-separated list. In production include the Vercel URL(s).
# e.g. CORS_ORIGIN=https://autoshkolla-platform.vercel.app,https://app.autoshkolla.com
CORS_ORIGIN=http://localhost:3000

# --- Super admin bootstrap (used by seed script) ---
SUPER_ADMIN_EMAIL=admin@autoshkolla-platform.com
SUPER_ADMIN_PASSWORD=change-me
